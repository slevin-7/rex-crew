#!/usr/bin/env python3
"""rex-crew: let one planning agent run Claude Code workers in Rex panes, here or on another Rex host.

One call (`run`) puts a task on the host, starts a worker, waits on its own program status,
answers routine permission prompts from a policy file, hands every other question back to you,
and returns the worker's written report plus what is actually on disk (git, a verify command).
Standard library only. See README.md.
"""
import argparse, base64, json, os, re, shlex, subprocess, sys, time

REPORT_PROTOCOL = """

---
## Report protocol (required)
You were started by an orchestrator that cannot see your screen, only this report.
When you are finished, or cannot continue, write the file `{report}` as your very last action:

STATUS: done | blocked | failed
CHANGED: one line per file: what changed for the user
VERIFIED: each command you ran and its result; then what you did NOT verify
COMMIT: hash and subject, or "none"
OPEN: anything unfinished, risky, or decided on your own
NEXT: one suggestion for a follow-up

Rules: do not rename the Rex session, do not push, do not chain shell commands with && or ;.
If only the user can decide something, ask and wait instead of guessing.
"""

SELF = os.environ.get("REX_BLOCK", "")


def die(msg, code=1):
    print(f"rex-crew: {msg}", file=sys.stderr)
    sys.exit(code)


class Rex:
    def __init__(self, host, session):
        self.host, self.session = host, session

    def call(self, *args, check=True):
        cmd = ["rex"] + (["-S", self.host] if self.host else []) + list(args)
        p = subprocess.run(cmd, capture_output=True, text=True)
        if check and p.returncode != 0:
            die(f"rex {' '.join(args[:3])} failed: {p.stderr.strip()[:300]}")
        return p

    def status(self, block):
        """The worker's own report (OSC 7501), or {} when it has reported nothing."""
        p = self.call("block", "call", "-s", self.session, "-b", block, "program_status", check=False)
        try:
            recs = json.loads(p.stdout).get("records") or []
        except ValueError:
            return {"state": "gone"}
        return recs[0] if recs else {}

    def screen(self, block, lines=20):
        out = self.call("capture", "-s", self.session, "-b", block, "--trim", check=False).stdout
        return "\n".join([l for l in out.splitlines() if l.strip()][-lines:])

    def key(self, block, key):
        self.call("send-key", "-s", self.session, "-b", block, key)

    def type(self, block, text):
        self.call("send", "-s", self.session, "-b", block, text)

    def sh(self, script):
        """Run a shell script on the host in a throwaway tab; return (exit status, output)."""
        p = self.call("run", "-s", self.session, "--label", "crew-sh", "--keep-open", "--focus=false",
                      "--json", "--wait", "--", "sh", "-c", script, check=False)
        try:
            block = json.loads(p.stdout[: p.stdout.rindex("}") + 1])["block_ids"][0]
        except (ValueError, KeyError, IndexError):
            die(f"could not run a command on the host: {p.stderr.strip()[:300] or p.stdout[:300]}")
        out = self.call("capture", "-s", self.session, "-b", block, "--trim", "--unwrap", check=False).stdout
        self.call("block", "close", "-s", self.session, block, check=False)
        return p.returncode, out


def guard(block):
    if block == SELF:
        die("refusing to act on the orchestrator's own pane", 2)


def question(rec):
    """`permission approve Bash: git status` -> ('permission', 'Bash: git status')."""
    msg = rec.get("msg") or ""
    return rec.get("kind") or "", msg.split("approve ", 1)[-1] if "approve " in msg else msg


def load_policy(path):
    if not path:
        return [], []
    with open(os.path.expanduser(path)) as f:
        p = json.load(f)
    return [re.compile(x) for x in p.get("approve", [])], [re.compile(x) for x in p.get("never", [])]


def routine(text, approve, never):
    return bool(text) and not any(r.search(text) for r in never) and any(r.search(text) for r in approve)


def approve_once(rex, block, expect):
    """Press a one-time Yes, only if the prompt on screen is still the one we read."""
    rec = rex.status(block)
    kind, text = question(rec)
    if rec.get("state") != "blocked" or kind != "permission" or text != expect:
        return False
    if rec.get("app", "claude-code") != "claude-code":
        return False  # other agents' dialogs are not known well enough to press keys in
    rex.type(block, "1")
    return True


def wait(rex, block, timeout, policy, trust_dir=None):
    """Block until the worker's turn ends or it needs a person. Returns a result dict."""
    approve, never = policy
    start, seen_work, approved = time.time(), False, []
    while time.time() - start < timeout:
        rec = rex.status(block)
        state = rec.get("state", "none")
        if state == "working":
            seen_work = True
        elif state in ("done", "idle") and (seen_work or time.time() - start > 30):
            return {"state": "done", "approved": approved}
        elif state == "error":
            return {"state": "error", "question": rec.get("msg", ""), "approved": approved}
        elif state == "blocked":
            kind, text = question(rec)
            if kind == "permission" and routine(text, approve, never) and approve_once(rex, block, text):
                approved.append(text)
                time.sleep(2)
                continue
            return {"state": "blocked", "kind": kind, "question": text, "approved": approved}
        elif state == "gone":
            return {"state": "gone", "approved": approved}
        elif time.time() - start > 15:
            # Dialogs shown before the agent starts (folder trust) are not reported as `blocked`.
            scr = rex.screen(block, 14)
            if trust_dir and "trust" in scr.lower() and trust_dir.rstrip("/") in scr.replace("\n", ""):
                rex.key(block, "down")
                time.sleep(1)
                rex.key(block, "enter")
                approved.append(f"folder trust: {trust_dir}")
                start = time.time()
                continue
            return {"state": "blocked", "kind": "startup", "question": scr, "approved": approved}
        time.sleep(4)
    return {"state": "timeout", "approved": approved}


def start(rex, name, directory, prompt, agent_args):
    if not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", name):
        die("NAME must be lowercase a-z0-9_- and at most 32 characters", 2)
    # The prompt goes first: --allowedTools is variadic and would swallow it.
    line = ("export PATH=\"$HOME/.local/bin:/opt/homebrew/bin:$PATH\"; cd " + shlex.quote(directory)
            + " && exec claude " + shlex.quote(prompt) + " " + " ".join(shlex.quote(a) for a in agent_args))
    p = rex.call("run", "-s", rex.session, "--label", name, "--keep-open", "--focus=false", "--json",
                 "--", "sh", "-c", line)
    return json.loads(p.stdout)["block_ids"][0]


def finish(rex, name, directory, verify):
    """What is really on disk: the report file, git, and the verify command's exit status."""
    d = shlex.quote(directory)
    script = (f"cd {d} || exit 97; echo @@REPORT; base64 < .rex-crew/report-{name}.md 2>/dev/null | tr -d '\\n'; echo; "
              "echo @@GIT; git log -1 --format='%h %s' 2>/dev/null; echo \"dirty $(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')\"; "
              "echo @@VERIFY; " + (f"( {verify} ) >/tmp/rex-crew-verify.$$ 2>&1; rc=$?; tail -n 15 /tmp/rex-crew-verify.$$; rm -f /tmp/rex-crew-verify.$$; echo @@RC $rc" if verify else "echo @@RC none"))
    _, out = rex.sh(script)
    part = lambda a, b: out.split(a, 1)[-1].split(b, 1)[0].strip() if a in out else ""
    try:
        report = base64.b64decode(re.sub(r"\s", "", part("@@REPORT", "@@GIT"))).decode("utf-8", "replace").strip()
    except ValueError:
        report = ""
    rc = re.search(r"@@RC (\S+)", out)
    return {"report": report or "(the worker wrote no report file)", "git": part("@@GIT", "@@VERIFY"),
            "verify_tail": part("@@VERIFY", "@@RC") if verify else "", "verify": rc.group(1) if rc else "unknown"}


def show(res):
    """Compact, stable text for the orchestrator: facts first, the worker's words last."""
    print(f"state: {res['state']}" + (f"   block: {res['block']}" if res.get("block") else "")
          + (f"   {res['seconds']}s" if "seconds" in res else ""))
    if res.get("approved"):
        print(f"auto-approved ({len(res['approved'])}): " + " | ".join(a[:70] for a in res["approved"][:6]))
    if res["state"] in ("blocked", "error"):
        print(f"needs you ({res.get('kind', 'error')}): {res.get('question', '')}")
    if "git" in res:
        print("git: " + " · ".join(res["git"].splitlines()))
        if res["verify"] != "none":
            print(f"verify: exit {res['verify']}" + ("" if res["verify"] == "0" else "\n" + res["verify_tail"]))
        print("report:\n" + res["report"])


def cmd_run(rex, a):
    policy = load_policy(a.policy)
    if a.block:
        block = a.block
    else:
        task = sys.stdin.read() if a.task == "-" else open(os.path.expanduser(a.task)).read()
        task += REPORT_PROTOCOL.format(report=f".rex-crew/report-{a.name}.md")
        b64 = base64.b64encode(task.encode()).decode()
        d = shlex.quote(a.dir)
        # .rex-crew/ holds task and report; keep it out of git without touching the repo's files.
        rc, out = rex.sh(f"cd {d} || exit 97; mkdir -p .rex-crew && rm -f .rex-crew/report-{a.name}.md && "
                         f"echo {b64} | base64 -d > .rex-crew/task-{a.name}.md && "
                         "x=$(git rev-parse --git-common-dir 2>/dev/null) && { grep -qx '.rex-crew/' \"$x/info/exclude\" 2>/dev/null || echo '.rex-crew/' >> \"$x/info/exclude\"; }; echo @@PUT ok")
        if "@@PUT ok" not in out:
            die(f"could not put the task into {a.dir} on the host: {out.strip()[-300:]}")
        block = start(rex, a.name, a.dir, f"Read .rex-crew/task-{a.name}.md in this directory and carry it out completely.", a.agent_args)
    t0 = time.time()
    res = wait(rex, block, a.timeout, policy, a.dir if a.trust else None)
    res.update(block=block, seconds=int(time.time() - t0))
    if res["state"] == "done":
        res.update(finish(rex, a.name, a.dir, a.verify))
        if not a.keep:
            rex.call("block", "close", "-s", rex.session, block, check=False)
            res.pop("block")
    show(res)
    sys.exit({"done": 0, "blocked": 2, "timeout": 3, "error": 4, "gone": 5}[res["state"]])


def cmd_wait(rex, a):
    guard(a.block)
    res = wait(rex, a.block, a.timeout, load_policy(a.policy))
    res["block"] = a.block
    show(res)
    sys.exit({"done": 0, "blocked": 2, "timeout": 3, "error": 4, "gone": 5}[res["state"]])


def cmd_send(rex, a):
    guard(a.block)
    state = rex.status(a.block).get("state")
    if state not in ("done", "idle"):
        die(f"not sent: the worker is {state or 'not reporting'} (a stray Return would answer its dialog)", 6)
    rex.type(a.block, " ".join(a.text))
    time.sleep(1)  # let the TUI draw the text before Return
    rex.key(a.block, "enter")


def cmd_approve(rex, a):
    guard(a.block)
    kind, text = question(rex.status(a.block))
    if a.match and not re.search(a.match, text):
        die(f"the open prompt does not match: {text}", 7)
    if not approve_once(rex, a.block, text):
        die("no permission prompt open, or not a Claude Code pane", 6)
    print(f"approved once: {text}")


def cmd_deny(rex, a):
    guard(a.block)
    if rex.status(a.block).get("state") != "blocked":
        die("nothing to deny", 6)
    rex.key(a.block, "escape")


def cmd_status(rex, a):
    blocks = json.loads(rex.call("block", "ls", "-s", rex.session, "--json").stdout)["blocks"]
    for b in blocks:
        rec = rex.status(b["block_id"])
        if not rec and not a.all:
            continue
        kind, text = question(rec)
        print("\t".join([rec.get("state", "-"), b.get("label", "-"), b["block_id"], (kind + " " + text).strip()[:100]]))


def cmd_session(rex, a):
    sessions = json.loads(rex.call("ls", "--json").stdout).get("sessions", [])
    hit = [s["session_id"] for s in sessions if s.get("label") == a.label]
    print(hit[0] if hit else json.loads(rex.call("new", a.label, "--json").stdout)["session_id"])


def selftest():
    ap, nv = [re.compile(r"^Bash: (rtk )?git (status|log)\b")], [re.compile(r"\brm\b|git push")]
    assert routine("Bash: git status --short", ap, nv)
    assert routine("Bash: rtk git log -1", ap, nv)
    assert not routine("Bash: git status; rm -rf x", ap, nv)
    assert not routine("Bash: git push", ap, nv) and not routine("", ap, nv)
    assert question({"kind": "permission", "msg": "hook failed · approve Bash: ls"}) == ("permission", "Bash: ls")
    assert question({}) == ("", "")
    print("selftest ok")


def main():
    if sys.argv[1:2] == ["selftest"]:
        return selftest()
    argv, agent_args = sys.argv[1:], []
    if "--" in argv:
        i = argv.index("--")
        argv, agent_args = argv[:i], argv[i + 1:]
    p = argparse.ArgumentParser(prog="rex-crew", description=__doc__.split("\n\n")[0])
    p.add_argument("-S", "--host", default=os.environ.get("REX_CREW_HOST"), help="Rex host label (default: this machine)")
    p.add_argument("-s", "--session", default=os.environ.get("REX_CREW_SESSION"), help="session id on that host")
    sub = p.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("run", help="task in, report out: start a worker, wait, answer routine prompts, verify")
    r.add_argument("name"); r.add_argument("dir"); r.add_argument("task", help="task file, or - for stdin")
    r.add_argument("--policy", help="JSON file: {approve: [regex], never: [regex]}")
    r.add_argument("--verify", help="shell command run in DIR on the host afterwards; its exit status is reported")
    r.add_argument("--timeout", type=int, default=900)
    r.add_argument("--trust", action="store_true", help="confirm the folder-trust dialog if it names DIR")
    r.add_argument("--keep", action="store_true", help="leave the worker's pane open after it finishes")
    r.add_argument("--block", help="resume a worker you answered by hand instead of starting one")
    r.set_defaults(fn=cmd_run)

    w = sub.add_parser("wait", help="wait for a worker's turn; exit 0 done, 2 needs you, 3 timeout")
    w.add_argument("block"); w.add_argument("--policy"); w.add_argument("--timeout", type=int, default=600)
    w.set_defaults(fn=cmd_wait)
    s = sub.add_parser("send", help="send a message; refused unless the worker is at its prompt")
    s.add_argument("block"); s.add_argument("text", nargs="+"); s.set_defaults(fn=cmd_send)
    ap = sub.add_parser("approve", help="one-time Yes to the open permission prompt")
    ap.add_argument("block"); ap.add_argument("--match", help="only if the prompt matches this regex"); ap.set_defaults(fn=cmd_approve)
    dn = sub.add_parser("deny", help="dismiss the open prompt (Escape)"); dn.add_argument("block"); dn.set_defaults(fn=cmd_deny)
    sc = sub.add_parser("screen", help="the last visible lines of a worker's pane")
    sc.add_argument("block"); sc.add_argument("lines", nargs="?", type=int, default=25)
    sc.set_defaults(fn=lambda rex, a: print(rex.screen(a.block, a.lines)))
    st = sub.add_parser("status", help="every reporting pane in the session: state, label, block, open question")
    st.add_argument("--all", action="store_true"); st.set_defaults(fn=cmd_status)
    cl = sub.add_parser("close", help="close a worker's pane"); cl.add_argument("block")
    cl.set_defaults(fn=lambda rex, a: (guard(a.block), rex.call("block", "close", "-s", rex.session, a.block)))
    se = sub.add_parser("session", help="print the id of the session with this label, creating it if needed")
    se.add_argument("label"); se.set_defaults(fn=cmd_session)

    a = p.parse_args(argv)
    a.agent_args = agent_args
    session = a.session or (None if a.host else os.environ.get("REX_SESSION"))
    if not session and a.cmd != "session":
        die("no session: pass -s, set REX_CREW_SESSION, or run `rex-crew -S HOST session LABEL`", 2)
    a.fn(Rex(a.host, session), a)


if __name__ == "__main__":
    main()
