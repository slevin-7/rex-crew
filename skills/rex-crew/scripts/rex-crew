#!/usr/bin/env python3
"""rex-crew: let one planning agent run Claude Code workers in Rex panes, here or on another Rex host.

`start` puts a task on the host and starts a worker; `collect` waits on the workers' own program
status, answers routine permission prompts from a policy file, hands every other question back to
you, and returns each worker's written report plus what is actually on disk (git, a verify command).
`run` is both for a single task. Standard library only. See README.md.
"""
import argparse, base64, contextlib, json, os, posixpath, re, shlex, subprocess, sys, tempfile, time
try:
    import fcntl
except ImportError:  # no flock on this platform: updates are still atomic, just not serialized
    fcntl = None

REPORT_PROTOCOL = """

---
## Report protocol (required)
You were started by an orchestrator that cannot see your screen, only this report.
When you are finished, or cannot continue, write the file `{report}` as your very last action:

STATUS: done | blocked | failed
CHANGED: one line per file: what changed for the user
VERIFIED: each command you ran and its result; then what you did NOT verify
COMMIT: hash and subject, or "none"
OPEN: anything unfinished, risky, or decided on your own
NEXT: one suggestion for a follow-up

Rules: do not rename the Rex session, do not push, run one shell command per call.
If only the user can decide something, ask and wait instead of guessing.
Plain read commands such as `git status`, `git log`, `git diff`, `git show`, `grep -n PATTERN FILE`, `sed -n A,Bp FILE`, `ls` and `cat`
usually pass without waiting. Wrapped in `sh -c '...'`, with `<( )`, `$( )` or backticks, behind an env prefix
(`VAR=x cmd`) or with a redirect other than `2>&1`, even a harmless read waits for a human: write it plainly instead.
"""

def read_preamble(path):
    """The orchestrator's standing instructions, read before anything is created: a bad file is a clear exit 2."""
    try:
        with open(os.path.expanduser(path), "rb") as f:
            data = f.read()
    except OSError as e:
        die(f"cannot read the preamble {path}: {e}", 2)
    if not data.strip():
        die(f"the preamble {path} is empty: give a file with the standing instructions, or leave --preamble out", 2)
    return data


def clean(text):
    """Worker text as display text: CRLF becomes LF; other control characters (ESC, a lone CR that overwrites the
    line, NUL) become '?', so a worker cannot clear the screen or hide a line it wrote."""
    return re.sub(r"[\x00-\x08\x0b-\x1f\x7f]", "?", str(text).replace("\r\n", "\n"))


def oneline(text, n):
    """One line of at most n characters: a worker's text must not start lines of the orchestrator's output."""
    return " ".join(clean(text).split())[:n]

SELF = os.environ.get("REX_BLOCK", "")
LEDGER = os.path.expanduser(os.environ.get("REX_CREW_STATE", "~/.local/state/rex-crew/runs.json"))
REPORT_MAX = 100000  # bytes of the worker's report that are read back
EXIT = {"done": 0, "unclean": 1, "blocked": 2, "timeout": 3, "error": 4, "gone": 5}


def die(msg, code=1):
    print(f"rex-crew: {msg}", file=sys.stderr)
    sys.exit(code)


def rpc_timeout():
    """Seconds one rex call may take (REX_CREW_TIMEOUT, default 120)."""
    try:
        return max(0.1, float(os.environ.get("REX_CREW_TIMEOUT") or 120))
    except ValueError:
        return 120.0


def jload(text):
    """The first JSON document that starts a line: rex may print a warning before (or after) its JSON."""
    dec = json.JSONDecoder()
    for m in re.finditer(r"^\s*[{\[]", text, re.M):
        try:
            return dec.raw_decode(text, m.end() - 1)[0]
        except ValueError:
            pass
    raise ValueError("no JSON in rex output")


class Rex:
    def __init__(self, host, session):
        self.host, self.session = host, session

    def call(self, *args, check=True, wait=None):
        """One rex call, bounded: a host that stops answering is an error that names it, not a hang forever."""
        cmd = ["rex"] + (["-S", self.host] if self.host else []) + list(args)
        limit = wait or rpc_timeout()
        try:
            p = subprocess.run(cmd, capture_output=True, text=True, timeout=limit)
        except subprocess.TimeoutExpired:
            die(f"rex {' '.join(args[:3])} on {self.host or 'this machine'} did not answer within {limit:g}s: the Rex host "
                "is not responding (set REX_CREW_TIMEOUT to wait longer)", 4)
        if check and p.returncode != 0:
            die(f"rex {' '.join(args[:3])} failed: {p.stderr.strip()[:300]}")
        return p

    def status(self, block):
        """The worker's own report (OSC 7501), or {} when it has reported nothing."""
        p = self.call("block", "call", "-s", self.session, "-b", block, "program_status", check=False)
        try:
            recs = jload(p.stdout).get("records") or []
        except (ValueError, AttributeError):
            return {"state": "gone"}
        return recs[0] if recs and isinstance(recs[0], dict) else {}

    def screen(self, block, lines=20):
        out = self.call("capture", "-s", self.session, "-b", block, "--trim", check=False).stdout
        return "\n".join([l for l in out.splitlines() if l.strip()][-lines:])

    def key(self, block, key):
        self.call("send-key", "-s", self.session, "-b", block, key)

    def type(self, block, text):
        # One Rex control request is limited to 65536 bytes: a long text travels in pieces.
        raw, i = text.encode(), 0
        while True:
            j = min(i + 30000, len(raw))
            while j < len(raw) and (raw[j] & 0xC0) == 0x80:  # never cut inside a UTF-8 character
                j -= 1
            piece = raw[i:j].decode()
            # text that starts with a dash must not be read as an option
            self.call("send", "-s", self.session, "-b", block, *(["--"] if piece.startswith("-") else []), piece)
            i = j
            if i >= len(raw):
                return

    def sh(self, script, wait=None):
        """Run a shell script on the host in a throwaway tab; return (exit status, output)."""
        if len(script.encode()) > 60000:  # one Rex control request is limited to 65536 bytes
            die("that command is too long for the host: one Rex control request is limited to 65536 bytes. "
                "Put it in a file in the directory and run the file", 2)
        p = self.call("run", "-s", self.session, "--label", "crew-sh", "--keep-open", "--focus=false",
                      "--json", "--wait", "--", "sh", "-c", script, check=False, wait=wait)
        try:
            block = jload(p.stdout)["block_ids"][0]
        except (ValueError, KeyError, IndexError, TypeError, AttributeError):
            die(f"could not run a command on the host: {p.stderr.strip()[:300] or p.stdout[:300]}")
        out = self.call("capture", "-s", self.session, "-b", block, "--trim", "--unwrap", check=False).stdout
        self.call("block", "close", "-s", self.session, block, check=False)
        return p.returncode, out


# ---- ledger: what was started, so a later call (or a later session) can pick it up -----------------

LIVE = ("open", "blocked", "timeout", "error")  # error: the pane is still there and may recover
LEDGER_KEYS = ("id", "name", "block", "state")


def ledger_raw():
    """The file's list as it is. A file that is not a JSON list is moved aside (never overwritten) and read as empty."""
    try:
        with open(LEDGER) as f:
            data = json.load(f)
        if isinstance(data, list):
            return data
    except FileNotFoundError:
        return []
    except (OSError, ValueError):
        pass
    try:
        aside = f"{LEDGER}.corrupt-{int(time.time())}"
        while os.path.exists(aside):  # two in one second: do not overwrite the first
            aside += "x"
        os.replace(LEDGER, aside)
        prune_litter()
        print(f"rex-crew: the ledger {LEDGER} is corrupt; kept as {aside}, starting an empty one", file=sys.stderr)
    except OSError:
        print(f"rex-crew: the ledger {LEDGER} is unreadable; treating it as empty", file=sys.stderr)
    return []


def prune_litter(keep=5):
    """Files next to the ledger that nothing reads again: old .corrupt-* copies (the newest few stay) and temp files
    a killed write left behind. The .lock file stays: removing it while another process holds it would split the lock."""
    d, base = os.path.dirname(LEDGER), os.path.basename(LEDGER)
    try:
        names = [n for n in os.listdir(d) if n.startswith(base + ".")]
        mt = lambda n: (os.path.getmtime(os.path.join(d, n)), n)
        corrupt = sorted((n for n in names if n.startswith(base + ".corrupt-")), key=mt)
        stale = [n for n in names if n != base + ".lock" and not n.startswith(base + ".corrupt-")
                 and time.time() - os.path.getmtime(os.path.join(d, n)) > 3600]
        for n in corrupt[:-keep] + stale:
            os.remove(os.path.join(d, n))
    except OSError:
        pass


def ledger_load():
    """Usable entries only: dicts that have the keys every command relies on (older versions may lack some)."""
    out = []
    for r in ledger_raw():
        if isinstance(r, dict) and all(k in r for k in LEDGER_KEYS):
            out.append({"host": "", "session": "", "dir": "", **r})
    return out


@contextlib.contextmanager
def ledger_lock():
    """One writer at a time (read-modify-write); a state path that cannot be written is a clear error."""
    try:
        os.makedirs(os.path.dirname(LEDGER), exist_ok=True)
        f = open(LEDGER + ".lock", "a")
    except OSError as e:
        die(f"cannot use the ledger at {LEDGER}: {e}. Set REX_CREW_STATE to a writable file", 4)
    try:
        if fcntl:
            fcntl.flock(f, fcntl.LOCK_EX)
        yield
    finally:
        f.close()


def ledger_update(run, base=None, locked=False):
    """Write one run. With `base` (its (state, t0) when it was read), a state that another process changed since
    (close, send, answer) is kept: only the fields that process does not own are taken from `run`."""
    with contextlib.nullcontext() if locked else ledger_lock():
        old = [r for r in ledger_raw() if isinstance(r, dict) and r.get("id") == run["id"]]
        if base and old and (old[0].get("state"), old[0].get("t0")) != base:
            run = {**run, "state": old[0].get("state"), "t0": old[0].get("t0"), "seen": old[0].get("seen", False)}
        runs = [r for r in ledger_raw() if not (isinstance(r, dict) and r.get("id") == run["id"])] + [run]
        # A start that never became a worker (no pane) leaves nothing worth keeping; a claim stuck for long is dead.
        runs = [r for r in runs if not (isinstance(r, dict) and not r.get("block") and (
            r.get("state") == "gone" or (r.get("state") == "starting" and time.time() - r.get("t0", 0) > 600)))]
        prune_litter()
        while len(runs) > 300:  # the cap drops the oldest finished entry, never a live worker
            i = next((i for i, r in enumerate(runs) if not (isinstance(r, dict) and r.get("state") in LIVE)), None)
            if i is None:
                break
            del runs[i]
        try:
            fd, tmp = tempfile.mkstemp(prefix=os.path.basename(LEDGER) + ".", dir=os.path.dirname(LEDGER))
            with os.fdopen(fd, "w") as f:
                json.dump(runs, f, indent=1)
            os.replace(tmp, LEDGER)
        except OSError as e:
            die(f"cannot write the ledger {LEDGER}: {e}", 4)


def mine(rex, states=LIVE):
    return [r for r in ledger_load() if r["host"] == (rex.host or "") and r["session"] == rex.session and r["state"] in states]

# ---- prompts and policy -----------------------------------------------------------------------------

def guard(block):
    if block == SELF:
        die("refusing to act on the orchestrator's own pane", 2)


def question(rec):
    """`permission approve Bash: git status` -> ('permission', 'Bash: git status')."""
    msg, kind = str(rec.get("msg") or ""), str(rec.get("kind") or "")  # the record comes from the worker's terminal
    # Only an "approve" before the first colon is the dialog's own prefix; one inside `Bash: ...` belongs to the command.
    m = re.match(r"[^:]*?\bapprove (.*)", msg, re.S)
    if not m:
        # A hook failure comes first and has colons of its own: `PreToolUse hook failed: ... · approve Bash: ls`.
        # The dialog's own prefix is the one `· approve `. Two of them (a hook text can echo a command) are
        # ambiguous: keep the whole message, which no pattern approves.
        marks = list(re.finditer(r"(?:^|·\s*)approve (?=\S)", msg))
        m = re.match(r"(.*)", msg[marks[0].end():], re.S) if len(marks) == 1 else None
    return kind, m.group(1) if m else msg


def load_policy(path):
    """The policy's two pattern lists. Anything off is a clear exit 2, never a half-read policy."""
    if not path:
        return [], []
    shape = 'a JSON object like {"approve": ["^Bash: git status(\\s|$)"], "never": ["git push"]}: two lists of regular expressions'
    try:
        with open(os.path.expanduser(path), encoding="utf-8") as f:
            p = json.load(f)  # ValueError covers bad JSON and bad UTF-8
        if not isinstance(p, dict) or set(p) - {"approve", "never"}:
            raise ValueError("only the keys approve and never are allowed")
        lists = []
        for key in ("approve", "never"):
            pats = p.get(key, [])
            if not isinstance(pats, list) or not all(isinstance(x, str) and x for x in pats):
                raise ValueError(f'"{key}" must be a list of non-empty strings (one regular expression each)')
            for x in pats:
                try:
                    re.compile(x)
                except re.error as e:
                    raise ValueError(f'invalid {key} pattern {x!r}: {e}')
            lists.append([re.compile(x) for x in pats])
        return lists[0], lists[1]
    except (OSError, ValueError) as e:
        die(f"cannot use the policy {path}: {e}. It must be {shape}. Fix the file, or leave out --policy to have nothing answered for you", 2)


def opaque(body):
    """True if the shell could turn this Bash text into a path no pattern has seen: $VAR, ${...}, brace lists, or a
    glob in a hidden (.x*) or directory segment (/e?c/, ~/.s?h/). Quoted text and a glob in the last segment are fine."""
    word, quote, i, n = [], None, 0, len(body)  # word: (char, is_glob) pairs
    def hit():
        segs, cur = [], []
        for ch, g in word:
            if ch == "/" and not g:
                segs.append(cur); cur = []
            else:
                cur.append((ch, g))
        segs.append(cur)
        for k, seg in enumerate(segs):
            if any(g for _, g in seg) and (k < len(segs) - 1 or (seg and seg[0] == (".", False))):
                return True
        txt = "".join(c for c, _ in word)
        return any(c == "{" and not g for c, g in word) and ("," in txt or ".." in txt)
    while i < n:
        c = body[i]
        if quote == "'":
            if c == "'":
                quote = None
            else:
                word.append((c, False))
        elif c == "\\" and i + 1 < n:
            i += 1
            word.append((body[i], False))
        elif c == "$" and body[i + 1:i + 2] and (body[i + 1].isalnum() or body[i + 1] in "_{@*#?!$-"):
            return True
        elif quote == '"':
            if c == '"':
                quote = None
            else:
                word.append((c, False))
        elif c in "'\"":
            quote = c
        elif c.isspace() or c in ";&|<>":
            if hit():
                return True
            word = []
        else:
            word.append((c, c in "*?["))
        i += 1
    return hit()


def parts(text):
    """`Bash: a; b | c` -> ['Bash: a', 'Bash: b', 'Bash: c'], splitting only outside quotes."""
    tool, sep, body = text.partition(": ")
    if tool != "Bash" or not sep:
        return [text]
    try:
        # 2>&1 and >/dev/null change nothing on disk; every other redirection is a write and is never routine.
        # Only when nothing is glued to them: `>&2file` and `> /dev/nullx` are writes to a file.
        body = re.sub(r"(?<!&)\d?>&\d(?![^\s;&|])|(?<!>)\d?>\s*/dev/null(?![^\s;&|])", "", body)
        # Newline and CR end a command like `;` does, and a `#` comment must not swallow the next line.
        lex = shlex.shlex(body, posix=True, punctuation_chars=";&|<>\r\n")
        lex.whitespace, lex.commenters = " \t", ""
        lex.whitespace_split = True
        out, cur = [], []
        for tok in lex:
            if tok and set(tok) <= set(";&|<>\r\n") and set(tok) & set("<>"):
                return ["Bash: <redirection>"]  # also `&>`, `>&`, `|&>`, `<(`
            if tok and set(tok) <= set(";&|\r\n"):
                out.append(cur); cur = []
            else:
                cur.append(tok)
        out.append(cur)
    except ValueError:
        return [text]  # unbalanced quotes: treat as one command, which no pattern should approve
    return [f"Bash: {' '.join(c)}" for c in out if c]


def routine(text, approve, never):
    """Every command of a chain must be approved on its own; one `never` hit rejects the whole prompt."""
    if not text or any(r.search(text) for r in never):
        return False
    ps = parts(text)
    # `never` also sees the command as the shell will read it: `~/.s''sh` is `~/.ssh`.
    # Command substitution runs something no pattern has seen, so it is never routine.
    if "`" in text or "$(" in text or any(r.search(p) for r in never for p in ps):
        return False
    tool, _, body = text.partition(": ")
    if tool == "Bash":
        # `cd /etc` then a relative `cat hosts`: the directory itself must pass `never` as a directory.
        if opaque(body) or any(r.search(p + "/") for r in never for p in ps if re.match(r"Bash: (cd|pushd)(\s|$)", p)):
            return False
    else:
        # A path prefix pattern must not be walked out of: `..` components, or a second line, are never routine.
        if ".." in body.split("/") or "\n" in body or "\r" in body or "\0" in body:
            return False
        if body.startswith("/") and any(r.search(f"{tool}: {posixpath.normpath(body)}") for r in never):
            return False
    # Anchored at the start: an unanchored pattern must not approve a command that merely mentions it later.
    return "Bash: <redirection>" not in ps and all(any(r.match(p) for r in approve) for p in ps)


def approve_once(rex, block, expect):
    """Press a one-time Yes, only if the prompt on screen is still the one we read."""
    rec = rex.status(block)
    kind, text = question(rec)
    if rec.get("state") != "blocked" or kind != "permission" or text != expect:
        return False
    if rec.get("app", "claude-code") != "claude-code":
        return False  # other agents' dialogs are not known well enough to press keys in
    rex.type(block, "1")
    return True


# ---- one worker --------------------------------------------------------------------------------------

def trust(rex, run):
    """Confirm the folder-trust dialog, but only if it names this worker's directory."""
    if time.time() - run.get("trust_at", 0) < 10:
        return True  # we pressed a moment ago; give the dialog time to close instead of pressing again
    squash = lambda t: re.sub(r"\s", "", t)
    scr = rex.screen(run["block"], 16)
    # Claude Code names the physical directory (the symlink resolved), the task gave the path it was started with.
    names = [squash(x.rstrip("/")) for x in (run["dir"], run.get("real")) if x]
    if not (run.get("trust") and "trust" in scr.lower() and any(n in squash(scr) for n in names)):
        return False
    rex.key(run["block"], "down")  # the default is "No, exit"
    time.sleep(1)
    rex.key(run["block"], "enter")
    run.setdefault("approved", []).append(f"folder trust: {run['dir']}")
    run["t0"] = run["trust_at"] = time.time()
    return True


def tick(rex, run, policy):
    """Look at one worker once. Returns None while it works, or a result dict when it stops."""
    approve, never = policy
    rec = rex.status(run["block"])
    state, age = rec.get("state", "none"), time.time() - run["t0"]
    if state != "blocked":
        run.pop("press", None)
    if state not in ("idle", "done"):
        run.pop("idle", None)
    if state == "gone":  # one failed status call is not a vanished pane: ask again on the next pass
        run["gone"] = run.get("gone", 0) + 1
        return {"state": "gone"} if run["gone"] >= 2 else None
    run.pop("gone", None)
    if state == "working":
        run["seen"] = True
    elif state == "done" and (run.get("seen") or age > 30):
        return {"state": "done"}
    elif state in ("idle", "done") and (run.get("seen") or age > 30 or state == "done"):
        # idle for one look can be the gap between two turns, and a young done we never saw working may be stale: see it twice
        run["idle"] = run.get("idle", 0) + 1
        if run["idle"] >= 2:
            return {"state": "done"}
    elif state == "error":
        return {"state": "error", "question": rec.get("msg", "")}
    elif state == "blocked":
        kind, text = question(rec)
        if "trust this folder" in text.lower():  # reported as a permission prompt by newer Claude Code
            return None if trust(rex, run) else {"state": "blocked", "kind": "startup", "question": rex.screen(run["block"], 14)}
        run["seen"] = True
        if kind == "permission" and not re.match(r"[\w.\-]+: \S", text):
            # A very long command is reported as just `permission prompt`: nothing to match, so never routine.
            # Give the orchestrator the screen, so it can decide without a second call.
            return {"state": "blocked", "kind": kind, "question": f"{text}\nthe worker's screen:\n{rex.screen(run['block'], 20)}"}
        if kind == "permission" and routine(text, approve, never):
            last, n, at = run.get("press") or ["", 0, 0]
            n, at = (n, at) if last == text else (0, 0)
            if n and time.time() - at < 10:
                return None  # the same prompt is still up right after our key: wait, do not type a second 1
            if n >= 3:
                return {"state": "blocked", "kind": kind, "prompt": text, "question": text + "  (approved 3 times, the prompt stays)"}
            if approve_once(rex, run["block"], text):
                run["press"] = [text, n + 1, time.time()]
                run.setdefault("approved", []).append(text)
                return None
        return {"state": "blocked", "kind": kind, "prompt": text, "question": text}
    elif state == "none" and age > 15 and not run.get("seen"):
        # Dialogs shown before the agent starts (folder trust) are not reported as `blocked`.
        return None if trust(rex, run) else {"state": "blocked", "kind": "startup", "question": rex.screen(run["block"], 14)}
    return None


def start(rex, a, agent_args):
    if not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", a.name):
        die("NAME must be lowercase a-z0-9_- and at most 32 characters", 2)
    try:  # bytes, not text: a task that is not UTF-8 or has CRLF line ends must arrive as written
        task = getattr(a, "task_bytes", None)  # fanout has read it already
        if task is None:
            task = sys.stdin.buffer.read() if a.task == "-" else open(os.path.expanduser(a.task), "rb").read()
    except OSError as e:
        die(f"cannot read the task: {e}", 2)
    pre = getattr(a, "preamble_bytes", None)
    if pre is None and getattr(a, "preamble", None):
        pre = read_preamble(a.preamble)
    if pre:
        task = task + b"\n\n---\n## Standing instructions from the orchestrator\n" + pre.strip() + b"\n"
    # A symlinked DIR and its real path are the same directory: compare what the host resolves.
    _, rd = rex.sh(f"printf '@@DIR %s@@END\\n' \"$(cd -- {shlex.quote(a.dir)} 2>/dev/null && pwd -P)\"")
    hit = re.search(r"@@DIR (.+?)@@END", rd, re.S)
    real = hit.group(1) if hit else a.dir
    same = lambda r: r["dir"].rstrip("/") == a.dir.rstrip("/") or r.get("real", r["dir"]).rstrip("/") == real.rstrip("/")
    for r in [r for r in mine(rex) if same(r)]:
        # its pane is closed: it cannot hold the directory. One failed status call is not proof (tick asks twice too).
        if rex.status(r["block"]).get("state") == "gone" and rex.status(r["block"]).get("state") == "gone":
            r["state"] = "gone"
            ledger_update(r)
    # Check and claim under one lock: two starts at the same moment must not both pass. A claim that never
    # became a worker (the start died half way) stops counting after a while.
    with ledger_lock():
        busy = [r for r in ledger_load() if r["host"] == (rex.host or "") and r["session"] == rex.session and same(r)
                and (r["state"] in LIVE or (r["state"] == "starting" and time.time() - r.get("t0", 0) < 120))]
        if busy:
            die(f"{a.dir} already has a live worker ({busy[0]['name']}): one worker per directory; use `checkout`", 2)
        claim = {"id": f"{int(time.time())}-{a.name}-{os.urandom(3).hex()}", "name": a.name, "dir": a.dir, "real": real,
                 "host": rex.host or "", "session": rex.session, "block": "", "state": "starting", "t0": time.time(),
                 "started": time.strftime("%Y-%m-%d %H:%M")}
        ledger_update(claim, locked=True)
    try:
        return launch(rex, a, agent_args, task, claim)
    except BaseException:
        claim["state"] = "gone"
        ledger_update(claim)
        raise


def launch(rex, a, agent_args, task, claim):
    task += REPORT_PROTOCOL.format(report=f".rex-crew/report-{a.name}.md").encode()
    b64, d = base64.b64encode(task).decode(), shlex.quote(a.dir)
    # .rex-crew/ holds task and report; keep it out of git without touching the repo's files.
    # Rex limits one request to 64 KiB, so a long task travels in pieces.
    step = 30000
    for i in range(0, len(b64), step):
        pre = (f"mkdir -p .rex-crew && rm -f .rex-crew/report-{a.name}.md .rex-crew/task-{a.name}.b64 && "
               "x=$(git rev-parse --git-common-dir 2>/dev/null) && { grep -qx '.rex-crew/' \"$x/info/exclude\" 2>/dev/null || echo '.rex-crew/' >> \"$x/info/exclude\"; }; ") if i == 0 else ""
        post = f" && base64 -d < .rex-crew/task-{a.name}.b64 > .rex-crew/task-{a.name}.md && rm .rex-crew/task-{a.name}.b64" if i + step >= len(b64) else ""
        _, out = rex.sh(f"cd -- {d} || exit 97; {pre}printf %s {b64[i:i + step]} >> .rex-crew/task-{a.name}.b64{post} && echo @@PUT ok")
        if "@@PUT ok" not in out:
            die(f"could not put the task into {a.dir} on the host: {out.strip()[-300:]}")
    prompt = f"Read .rex-crew/task-{a.name}.md in this directory and carry it out completely."
    # The prompt goes first: --allowedTools is variadic and would swallow it.
    line = ("export PATH=\"$HOME/.local/bin:/opt/homebrew/bin:$PATH\"; cd -- " + d
            + " && exec claude " + shlex.quote(prompt) + " " + " ".join(shlex.quote(x) for x in agent_args))
    try:
        p = rex.call("run", "-s", rex.session, "--label", a.name, "--keep-open", "--focus=false", "--json", "--", "sh", "-c", line)
        block = jload(p.stdout)["block_ids"][0]
    except (SystemExit, ValueError, KeyError, IndexError, TypeError, AttributeError):
        close_strays(rex, a.name)  # the pane may exist although the answer never came: do not leave it running unrecorded
        raise
    run = {**claim, "block": block, "verify": a.verify, "verify_timeout": a.verify_timeout,
           "trust": a.trust, "keep": a.keep, "state": "open", "t0": time.time()}
    try:
        ledger_update(run)
    except SystemExit:
        rex.call("block", "close", "-s", rex.session, block, check=False)
        raise
    return run


def close_strays(rex, name):
    """After a start that failed half way: close panes labelled NAME that no ledger entry knows."""
    try:
        known = {r["block"] for r in ledger_load()}
        for b in jload(rex.call("block", "ls", "-s", rex.session, "--json").stdout).get("blocks", []):
            if b.get("label") == name and b.get("block_id") not in known:
                rex.call("block", "close", "-s", rex.session, b["block_id"], check=False)
                print(f"rex-crew: closed the half-started pane {b['block_id']} ({name})", file=sys.stderr)
    except (SystemExit, ValueError, KeyError, TypeError, AttributeError):
        print(f"rex-crew: could not check for a half-started pane named {name}; see 'rex-crew status'", file=sys.stderr)


def finish(rex, run):
    """What is really on disk: the report file, git, and the verify command's exit status."""
    d, verify, m = shlex.quote(run["dir"]), run.get("verify"), f"@@{os.urandom(6).hex()}"
    vt = int(run.get("verify_timeout") or 600)
    f = f".rex-crew/report-{run['name']}.md"
    # A worker controls the report path: never follow a symlink out of the directory, never ship more than REPORT_MAX bytes.
    rep = (f"if [ -L .rex-crew ] || [ -L {f} ]; then printf @LINK@; elif [ -f {f} ]; then head -c {REPORT_MAX + 1} {f} | base64 | tr -d '\\n'; fi; echo; ")
    script = (f"cd -- {d} || exit 97; echo {m}REPORT; {rep}"
              f"echo {m}GIT; git log -1 --format='%h %s' 2>/dev/null; echo \"branch $(git branch --show-current 2>/dev/null) · dirty $(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')\"; "
              f"echo {m}VERIFY; " + (
                  # A watchdog kills the verify command and all its children when it hangs (no job control: not every sh has it).
                  "kt() { set -- \"$1\" \"$2\" $(ps -A -o pid= -o ppid= | awk -v p=\"$1\" '$2==p{print $1}'); kill -s \"$2\" \"$1\" 2>/dev/null; s=$2; shift 2; for c; do kt \"$c\" \"$s\"; done; }; "
                  f"vf=$(mktemp \"${{TMPDIR:-/tmp}}/rex-crew-verify.XXXXXX\") || exit 96; "
                  f"( {verify}\n) </dev/null >\"$vf\" 2>&1 & vp=$!; "
                  f"( sleep {vt}; : > \"$vf.to\"; kt $vp TERM; sleep 3; kt $vp KILL ) </dev/null >/dev/null 2>&1 & wp=$!; "
                  f"wait $vp 2>/dev/null; rc=$?; kt $wp TERM; if [ -e \"$vf.to\" ]; then rc=timeout; fi; "
                  f"tail -n 15 \"$vf\" | tail -c 4000; rm -f \"$vf\" \"$vf.to\"; echo {m}RC $rc" if verify else f"echo {m}RC none"))
    # the verify command may run up to vt seconds: the call waits that long on top
    rc0, out = rex.sh(script, **({"wait": rpc_timeout() + vt + 10} if verify else {}))
    part = lambda x, y: out.split(x, 1)[-1].split(y, 1)[0].strip() if x in out else ""
    notes, raw = [], part(m + "REPORT", m + "GIT")
    try:
        body = b"" if raw == "@LINK@" else base64.b64decode(re.sub(r"\s", "", raw))
    except ValueError:
        body = b""
    if raw == "@LINK@":
        notes.append("the report path is a symlink: not read")
    if len(body) > REPORT_MAX:
        body = body[:REPORT_MAX]
        notes.append(f"the report is longer than {REPORT_MAX} bytes: cut")
    report = clean(body.decode("utf-8", "replace")).strip()
    if rc0 == 97:
        notes.append("the directory is gone on the host: nothing could be read")
    elif m + "REPORT" not in out or m + "RC" not in out:
        notes.append("the host's output is incomplete (the terminal kept only its last lines, or the command died): report, git and verify may be missing")
    rc = re.search(re.escape(m) + r"RC (\S+)", out)
    res = {"report": report, "git": part(m + "GIT", m + "VERIFY"),
           "verify_tail": part(m + "VERIFY", m + "RC") if verify else "", "verify_rc": rc.group(1) if rc else "unknown"}
    # "done" only means the turn ended. Say plainly when the result is not clean.
    # The template line `STATUS: done | blocked | failed` is not an answer, and neither is a missing line.
    said = [w.lower() for w, rest in re.findall(r"^STATUS:\s*[*`_]*(\w+)[*`_]*(.*)$", report, re.M) if "|" not in rest]
    said = [w for w in said if w in ("done", "blocked", "failed")]
    res["attention"] = notes + [x for x in (
        None if report or notes else "the worker wrote no report file",
        None if not report or said else "the report has no STATUS line (done, blocked or failed); do not read it as clean",
        None if all(w == "done" for w in said) else f"the worker reports STATUS {next(w for w in said if w != 'done')}",
        None if res["verify_rc"] in ("0", "none") else (f"verify did not finish within {vt}s and was killed" if res["verify_rc"] == "timeout"
                                                        else f"verify failed (exit {res['verify_rc']})"),
        None if not re.search(r"dirty [1-9]", res["git"]) else "uncommitted changes in the directory") if x]
    return res


SECTIONS = ("CHANGED", "OPEN")
_HEAD = re.compile(r"^[ \t>#*`_]*(STATUS|CHANGED|VERIFIED|COMMIT|OPEN|NEXT)[*`_ \t]*:[*`_ \t]*(.*)$|^#+[ \t]*(STATUS|CHANGED|VERIFIED|COMMIT|OPEN|NEXT)[ \t]*$")
BRIEF_LINES, BRIEF_WIDTH = 12, 160


def brief_report(report):
    """Only the CHANGED and OPEN sections of a report, capped. A section the worker left out is said so: silence would read as 'nothing'."""
    secs, cur = {}, None
    for line in report.splitlines():
        m = _HEAD.match(line)
        if m:
            cur = m.group(1) or m.group(3)
            secs.setdefault(cur, [])
            if (m.group(2) or "").strip():
                secs[cur].append(m.group(2).strip())
        elif cur:
            secs[cur].append(line.strip())
    out = []
    for key in SECTIONS:
        body = [l for l in secs.get(key, []) if l]
        if key not in secs:
            out.append(f"{key}: (missing from the report: read it without --brief)")
            continue
        cut = lambda l: l if len(l) <= BRIEF_WIDTH else l[:BRIEF_WIDTH] + "..."
        if not body:
            out.append(f"{key}: (empty)")
        elif len(body) == 1:
            out.append(f"{key}: {cut(body[0])}")
        else:
            out += [f"{key}:"] + ["  " + cut(l) for l in body[:BRIEF_LINES]]
            if len(body) > BRIEF_LINES:
                out.append(f"  (+{len(body) - BRIEF_LINES} more lines: read the full report without --brief)")
    return "\n".join(out)


def answer_lines(run, res):
    """The exact command lines that answer what a worker asked, ready to copy."""
    q = shlex.quote
    pre = "rex-crew" + (f" -S {q(run['host'])}" if run.get("host") else "") + f" -s {q(run['session'])}"
    b, kind, prompt = q(run["block"]), res.get("kind") or "", res.get("prompt") or ""
    if res["state"] == "error" or kind == "startup":
        return [f"look:    {pre} screen {b}", f"close:   {pre} close {b}"]
    if kind == "question":
        return [f"answer:  {pre} answer {b} 1        (an option number; {pre} screen {b} shows them)",
                f"or free text:  {pre} answer {b} {q('your text')} --text"]
    if kind == "permission":
        # --match makes the copy safe: it presses Yes only if the prompt still open is exactly this one
        match = f" --match {q('^' + re.escape(prompt) + chr(92) + 'Z')}" if prompt and clean(prompt) == prompt and "\n" not in prompt and len(prompt) <= 500 else ""
        look = "" if match else f"look first:  {pre} screen {b}\n"
        return [look + f"approve: {pre} approve {b}{match}", f"deny:    {pre} deny {b}"]
    return []


def show(run, res, brief=False):
    """Compact, stable text for the orchestrator: facts first, the worker's words last."""
    print(f"== {run['name']}   state: {res['state']}   {int(time.time() - run['t0'])}s"
          + ("" if res["state"] == "done" and not run.get("keep") and not res.get("attention") else f"   block: {run['block']}"))
    if run.get("approved") and not brief:
        print(f"auto-approved ({len(run['approved'])}): " + " | ".join(oneline(x, 60) for x in run["approved"][-5:]))
    if res["state"] in ("blocked", "error"):
        ask = clean(res.get("question") or "(no message; look at the pane)").replace("\n", "\n    ")
        print(f"needs you ({res.get('kind') or res['state']}): {ask}")
        for x in answer_lines(run, res):
            print("  " + x)
    if "git" in res:
        for x in res["attention"]:
            print(f"ATTENTION: {x}")
        print("git: " + " · ".join(res["git"].splitlines()))
        if res["verify_rc"] != "none":
            tail = clean(res["verify_tail"])
            if brief:
                tail = "\n".join(oneline(l, BRIEF_WIDTH) for l in tail.splitlines()[-6:])
            print(f"verify: exit {res['verify_rc']}" + ("" if res["verify_rc"] == "0" else "\n" + tail))
        print(brief_report(res["report"]) if brief and res["report"] else "report:\n" + (res["report"] or "(none)"))


def collect(rex, policy, timeout, only=None, rid=None, brief=False):
    """Watch every open worker of this session. Returns when all are done, or one needs a person."""
    runs = [r for r in mine(rex) if (not only or r["name"] == only) and (not rid or r["id"] == rid)]
    if not runs:
        known = [r for r in ledger_load() if r["host"] == (rex.host or "") and r["session"] == rex.session and r["name"] == only]
        if only and not known:
            die(f"no worker named {only} in this session (see: rex-crew runs)", 6)
        if known:  # finished earlier: say how, with the exit code of that outcome
            print(f"{only} already finished: state {known[-1]['state']}")
            return EXIT.get(known[-1]["state"], 0)
        print("no open workers in this session")
        return 0
    t0, worst, asked, first = time.time(), 0, False, True
    base = {r["id"]: (r["state"], r.get("t0")) for r in runs}
    pressed = 0  # keys we pressed for workers so far
    tally = {}  # outcome -> how many were reported (for --brief)
    count = lambda k: tally.__setitem__(k, tally.get(k, 0) + 1)

    def claim(r):
        """Take the end of this worker under the lock, unless another process already did (then it is theirs to report)."""
        with ledger_lock():
            cur = [x for x in ledger_raw() if isinstance(x, dict) and x.get("id") == r["id"]]
            if cur and (cur[0].get("state"), cur[0].get("t0")) != base[r["id"]]:
                return False
            ledger_update(r, locked=True)
            base[r["id"]] = (r["state"], r.get("t0"))
            return True

    def one(r):
        """Look at one worker; a host failure on it is reported and must not cost the others their results."""
        nonlocal worst, asked, pressed
        try:
            n = len(r.get("approved", []))
            try:
                res = tick(rex, r, policy)
            finally:
                pressed += max(0, len(r.get("approved", [])) - n)
            if not res:
                return
            runs.remove(r)
            r["state"] = res["state"]
            if res["state"] in ("done", "gone") and not claim(r):
                return  # another collect took this worker's result: it reports it, not this one
            if res["state"] == "done":
                res.update(finish(rex, r))
                if res.get("attention"):  # decided before anything is printed: show() must say what counts
                    r["state"] = res["state"] = "unclean"
                if not r.get("keep") and not res.get("attention"):  # an unclean worker keeps its pane: screen, then send
                    rex.call("block", "close", "-s", rex.session, r["block"], check=False)
        except SystemExit:  # die() already said why on stderr
            if r in runs:
                runs.remove(r)
            r["state"] = "open"  # not read yet: the next collect picks it up again
            print(f"== {r['name']}   state: error   block: {r['block']}\nneeds you (host): could not read this worker's state or result "
                  f"(see the message above); run collect {r['name']} again")
            count("needs you")
            ledger_update(r, base.get(r["id"]))
            worst = max(worst, EXIT["error"])
            return
        show(r, res, brief)
        count("needs you" if res["state"] in ("blocked", "error") else res["state"])
        ledger_update(r, base.get(r["id"]))
        worst = max(worst, EXIT[res["state"]])
        asked = asked or res["state"] == "blocked"

    extra = True  # a worker seen finished once needs a second look: with --timeout 0 that look is still made
    while runs and (first or time.time() - t0 < timeout or (extra and any(r.get("idle") for r in runs))):
        if not first and time.time() - t0 >= timeout:
            extra = False
        first = False
        before = pressed
        for r in list(runs):
            one(r)
        if asked:
            # Someone waits for the orchestrator and nobody presses routine keys for the others meanwhile. So serve them
            # a few more passes (at most ~12 s) while they still need keys, then hand the question back.
            for _ in range(3):
                if not runs or pressed == before:
                    break
                before = pressed
                time.sleep(4)
                for r in list(runs):
                    one(r)
            break
        if runs:
            time.sleep(4)
    for r in runs:
        ledger_update(r, base.get(r["id"]))
    if runs:
        print("still working: " + ", ".join(r["name"] for r in runs))
        worst = worst or 3
    if brief:
        order = ("done", "unclean", "needs you", "gone", "timeout")
        parts_ = [f"{tally[k]} {k}" for k in order if tally.get(k)] + ([f"{len(runs)} still working"] if runs else [])
        print(", ".join(parts_) or "nothing reported")
    return 2 if asked else worst  # a question for you outranks every other code


# ---- commands ----------------------------------------------------------------------------------------

def cmd_start(rex, a):
    run = start(rex, a, a.agent_args)
    print(f"started {run['name']}   block: {run['block']}   dir: {run['dir']}")


def cmd_run(rex, a):
    policy = load_policy(a.policy)  # before a pane exists: a bad policy must not leave a started worker behind
    run = start(rex, a, a.agent_args)
    sys.exit(collect(rex, policy, a.timeout, only=run["name"], rid=run["id"], brief=a.brief))


def cmd_collect(rex, a):
    sys.exit(collect(rex, load_policy(a.policy), a.timeout, only=a.name, brief=a.brief))


def cmd_runs(rex, a):
    shown = [r for r in ledger_load() if a.all or (r["host"] == (rex.host or "") and r["session"] == rex.session)]
    for r in shown[-(a.last or 20):]:
        print("\t".join([r["state"], r["name"], r.get("started", ""), r["host"] or "local", r["dir"],
                         "" if r["state"] in ("done", "closed", "gone") else r["block"]]))


def cmd_checkout(rex, a):
    print(checkout(rex, a.name, a.repo, a.base, a.branch, a.copy))


def checkout(rex, name, repo, base="HEAD", branch=None, copy=()):
    """A git worktree per worker, on its own branch, with the generated files it needs copied in. Returns its path."""
    if not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", name):
        die("NAME must be lowercase a-z0-9_- and at most 32 characters", 2)
    # The host resolves the repo path (a relative one is relative to the host's directory, not ours).
    copies = "".join(f" cp -R \"$r\"/{shlex.quote(c)} \"$wt\"/{shlex.quote(c)} &&" for c in copy)
    br = shlex.quote(branch or "crew/" + name)
    # A copy that fails removes the worktree and branch again, so a retry does not die with "branch exists".
    rc, out = rex.sh(f"r=$(cd -- {shlex.quote(repo)} && pwd) || exit 97; "
                     f"wt=\"$(dirname \"$r\")/.rex-crew-worktrees/$(basename \"$r\")/{name}\"; "
                     f"if [ -e \"$wt\" ]; then echo \"@@EXISTS $wt\"; exit 3; fi; "
                     f"cd -- \"$r\" && LC_ALL=C git worktree add -q -b {br} \"$wt\" {shlex.quote(base)} && "
                     f"{{{copies} :; }} || {{ if [ -d \"$wt\" ]; then echo @@COPYFAIL; git worktree remove --force \"$wt\" >/dev/null 2>&1; "
                     f"rm -rf \"$wt\"; git worktree prune; git branch -D {br} >/dev/null 2>&1; fi; exit 1; }}; echo \"@@WT $wt\"")
    hit = re.search(r"^@@WT (.+)$", out, re.M)
    if not hit:
        ex = re.search(r"^@@EXISTS (.+)$", out, re.M)
        if ex:
            die(f"checkout failed: {ex.group(1).strip()} already exists (a worker of that name has a checkout): use it, "
                "or remove it with `git worktree remove` first, or pick another NAME", 2)
        if "@@COPYFAIL" in out:
            die(f"checkout failed while copying: {out.replace('@@COPYFAIL', '').strip()[-300:]}\n"
                "the new worktree and branch were removed again; fix the --copy path and retry")
        if "already exists" in out:
            die(f"checkout failed: the branch {branch or 'crew/' + name} already exists: pass --branch, or delete the old branch. {out.strip()[-200:]}")
        die(f"checkout failed: {out.strip()[-300:]}")
    return hit.group(1).strip()


def cmd_sh(rex, a):
    m = f"@@{os.urandom(6).hex()}"
    rc, out = rex.sh(f"echo {m}BEGIN; " + " ".join(a.command))
    if m + "BEGIN" in out:
        out = out.split(m + "BEGIN", 1)[1].lstrip("\n")
    else:  # the terminal keeps only its last lines: say that the start of the output is missing
        print("rex-crew: the output is cut: the host's terminal kept only its last lines, the beginning is missing", file=sys.stderr)
    print(out.rstrip())
    sys.exit(rc)


def cmd_send(rex, a):
    guard(a.block)
    state = rex.status(a.block).get("state")
    if state not in ("done", "idle"):
        die(f"not sent: the worker is {state or 'not reporting'}, not at its prompt (a stray Return would answer its dialog). "
            f"Wait with `rex-crew collect`; if it is blocked, use approve, deny or answer; see `rex-crew status`", 6)
    rex.type(a.block, " ".join(a.text))
    time.sleep(1)  # let the TUI draw the text before Return
    rex.key(a.block, "enter")
    for r in mine(rex, ("open", "blocked", "timeout", "done", "unclean")):
        if r["block"] == a.block:  # a new turn: collect should wait for it again
            r.update(state="open", t0=time.time(), seen=False)
            ledger_update(r)


def cmd_approve(rex, a):
    guard(a.block)
    kind, text = question(rex.status(a.block))
    if a.match and not re.search(a.match, text):
        die(f"the open prompt does not match: {text}. Read it, then `rex-crew approve` without --match, or `rex-crew deny`", 7)
    if not approve_once(rex, a.block, text):
        die("no permission prompt open, or not a Claude Code pane. See `rex-crew status` for what the pane is doing", 6)
    print(f"approved once: {text[:200]}")


def cmd_answer(rex, a):
    """Answer a worker's question: pick a numbered option, or type free text into its last option."""
    guard(a.block)
    rec = rex.status(a.block)
    if rec.get("state") != "blocked" or rec.get("kind") != "question":
        die("no question open (for a permission prompt use approve or deny). See `rex-crew status`", 6)
    if re.fullmatch(r"[0-9]+", a.choice) and not a.text:
        rex.type(a.block, a.choice)
    else:
        free = re.search(r"(\d+)\. Type something", rex.screen(a.block, 30))
        if not free:
            die("this question takes no free text; answer with an option number (`rex-crew screen BLOCK` shows them)", 6)
        rex.type(a.block, free.group(1))
        time.sleep(1)
        rex.type(a.block, a.choice)
        time.sleep(1)
        rex.key(a.block, "enter")
    for r in mine(rex):
        if r["block"] == a.block:
            r.update(state="open", t0=time.time())
            ledger_update(r)


def cmd_deny(rex, a):
    guard(a.block)
    if rex.status(a.block).get("state") != "blocked":
        die("nothing to deny: the worker is not blocked. See `rex-crew status`", 6)
    rex.key(a.block, "escape")


def cmd_status(rex, a):
    blocks = jload(rex.call("block", "ls", "-s", rex.session, "--json").stdout)["blocks"]
    for b in blocks:
        rec = rex.status(b["block_id"])
        if not rec and not a.all:
            continue
        kind, text = question(rec)
        print("\t".join([rec.get("state", "-"), b.get("label", "-"), b["block_id"], (kind + " " + text).strip()[:100]]))


def cmd_close(rex, a):
    guard(a.block)
    rex.call("block", "close", "-s", rex.session, a.block)
    for r in mine(rex, LIVE + ("unclean",)):
        if r["block"] == a.block:
            r["state"] = "closed"
            ledger_update(r)


def cmd_session(rex, a):
    sessions = jload(rex.call("ls", "--json").stdout).get("sessions", [])
    hit = [s["session_id"] for s in sessions if s.get("label") == a.label]
    print(hit[0] if hit else jload(rex.call("new", a.label, "--json").stdout)["session_id"])


# ---- fanout and integrate ----------------------------------------------------------------------------

PLAN_KEYS = {"repo", "base", "copy", "claude_args", "verify", "verify_timeout", "trust", "preamble", "workers"}
NAME_RE = r"[a-z][a-z0-9_-]{0,31}"


def load_plan(path):
    """The plan, checked completely before anything is created: a typo must not become half a fan-out."""
    def bad(msg):
        die(f"cannot use the plan {path}: {msg}", 2)
    try:
        with open(os.path.expanduser(path), encoding="utf-8") as f:
            p = json.load(f)
    except (OSError, ValueError) as e:
        bad(str(e))
    if not isinstance(p, dict):
        bad('it must be a JSON object like {"repo": "/abs/repo", "workers": [{"name": "a", "task_file": "a.md"}]}')
    if set(p) - PLAN_KEYS:
        extra, allowed = sorted(set(p) - PLAN_KEYS)[0], ", ".join(sorted(PLAN_KEYS))
        bad(f"unknown key {extra!r}; allowed: {allowed}")
    strs = lambda v: isinstance(v, list) and all(isinstance(x, str) for x in v)
    if not isinstance(p.get("repo"), str) or not p["repo"].strip():
        bad('"repo" (the repository on the host) is missing')
    base = p.setdefault("base", "HEAD")
    if not isinstance(base, str) or not base or base.startswith("-") or "\n" in base:
        bad(f"invalid base {base!r}: give a branch, tag or commit")
    copy = p.setdefault("copy", [])
    if not strs(copy) or any(not c or c.startswith("/") or ".." in c.split("/") or "\n" in c for c in copy):
        bad('"copy" must be a list of paths inside the repository (no absolute path, no "..")')
    if not strs(p.setdefault("claude_args", [])):
        bad('"claude_args" must be a list of strings, one per argument')
    if p.setdefault("verify", None) is not None and not (isinstance(p["verify"], str) and p["verify"].strip()):
        bad('"verify" must be a shell command (a non-empty string); leave it out for no check')
    vt = p.setdefault("verify_timeout", 600)
    if not isinstance(vt, int) or isinstance(vt, bool) or vt < 1:
        bad('"verify_timeout" must be a number of seconds')
    if not isinstance(p.setdefault("trust", False), bool):
        bad('"trust" must be true or false')
    if "preamble" in p:
        if not isinstance(p["preamble"], str) or not p["preamble"].strip():
            bad('"preamble" must be the path of a file with the standing instructions')
        try:  # relative to the plan file, like task_file
            with open(os.path.join(os.path.dirname(os.path.abspath(os.path.expanduser(path))), os.path.expanduser(p["preamble"])), "rb") as f:
                p["preamble_body"] = f.read()
        except OSError as e:
            bad(f"cannot read the preamble: {e}")
        if not p["preamble_body"].strip():
            bad("the preamble file is empty")
    ws = p.get("workers")
    if not isinstance(ws, list) or not ws:
        bad('"workers" must be a non-empty list')
    seen = set()
    for w in ws:
        if not isinstance(w, dict) or not isinstance(w.get("name"), str) or not re.fullmatch(NAME_RE, w["name"]):
            who = w.get("name") if isinstance(w, dict) else w
            bad(f"worker {who!r}: NAME must be lowercase a-z0-9_- and at most 32 characters")
        n = w["name"]
        if set(w) - {"name", "task", "task_file"}:
            extra = sorted(set(w) - set(("name", "task", "task_file")))[0]
            bad(f"worker {n}: unknown key {extra!r}")
        if n in seen:
            bad(f"name {n} appears twice")
        seen.add(n)
        if ("task" in w) == ("task_file" in w) or not isinstance(w.get("task", w.get("task_file")), str):
            bad(f'worker {n} needs exactly one of "task" (text) or "task_file" (a path)')
        if "task" in w:
            try:
                w["body"] = w["task"].encode("utf-8")
            except UnicodeEncodeError:
                bad(f"worker {n}: the task text cannot be encoded as UTF-8 (a lone surrogate escape?)")
        else:
            try:  # relative to the plan file, so a plan and its tasks can be moved together
                with open(os.path.join(os.path.dirname(os.path.abspath(os.path.expanduser(path))), os.path.expanduser(w["task_file"])), "rb") as f:
                    w["body"] = f.read()
            except OSError as e:
                bad(f"worker {n}: cannot read the task file: {e}")
        if not w["body"].strip():
            bad(f"worker {n}: the task is empty")
    return p


def fanout_undo(rex, repo, made, runs):
    """Close the panes and remove the worktrees and branches this fan-out made, and only those."""
    for r in runs:
        rex.call("block", "close", "-s", rex.session, r["block"], check=False)
        r["state"] = "closed"
        ledger_update(r)
    if made:
        rm = "".join(f"git worktree remove --force {shlex.quote(p)} >/dev/null 2>&1; rm -rf {shlex.quote(p)}; "
                     f"git worktree prune; git branch -D {shlex.quote(b)} >/dev/null 2>&1; "
                     f"rmdir {shlex.quote(posixpath.dirname(p))} {shlex.quote(posixpath.dirname(posixpath.dirname(p)))} 2>/dev/null; " for p, b in made)
        rex.sh(f"cd -- {shlex.quote(repo)} && {{ {rm}:; }}")


def cmd_fanout(rex, a):
    plan = load_plan(a.plan)
    pre = read_preamble(a.preamble) if a.preamble else plan.get("preamble_body")  # the option wins over the plan's key
    names = [w["name"] for w in plan["workers"]]
    live = sorted({r["name"] for r in mine(rex)} & set(names))
    if live:
        die(f"a live worker named {live[0]} already exists in this session: collect or close it, or pick another NAME", 2)
    m, repo = f"@@{os.urandom(6).hex()}", plan["repo"]
    bq = shlex.quote(plan["base"] + "^{commit}")
    check = "".join(f"wt=\"$(dirname \"$r\")/.rex-crew-worktrees/$(basename \"$r\")/{n}\"; "
                    f"[ -e \"$wt\" ] && echo \"{m}ERR the checkout $wt already exists\"; "
                    f"git show-ref --verify -q refs/heads/crew/{n} && echo \"{m}ERR the branch crew/{n} already exists\"; " for n in names)
    check += "".join(f"[ -e \"$r\"/{shlex.quote(c)} ] || echo \"{m}ERR the copy path {c} does not exist in the repository\"; " for c in plan["copy"])
    rc, out = rex.sh(f"r=$(cd -- {shlex.quote(repo)} && pwd) || exit 97; cd -- \"$r\"; export LC_ALL=C; "
                     f"git rev-parse --git-dir >/dev/null 2>&1 || {{ echo {m}ERR {shlex.quote(repo)} is not a git repository; exit 1; }}; "
                     f"git rev-parse --verify -q {bq} >/dev/null 2>&1 || echo {m}ERR base {shlex.quote(plan['base'])} is not a commit in the repository; "
                     f"{check}echo {m}READY")
    errs = re.findall("^" + re.escape(m) + r"ERR (.*)$", out, re.M)
    if rc == 97:
        errs = [f"the repository {repo} was not found on the host"]
    elif not errs and m + "READY" not in out:
        errs = [f"the host's answer is incomplete: {out.strip()[-200:]}"]
    if errs:
        die("plan refused, nothing was created: " + "; ".join(errs), 2)
    made, runs = [], []
    try:
        for w in plan["workers"]:
            made.append((checkout(rex, w["name"], repo, plan["base"], None, plan["copy"]), "crew/" + w["name"]))
        for w, (path, _) in zip(plan["workers"], made):
            ns = argparse.Namespace(name=w["name"], dir=path, task=None, task_bytes=w["body"], verify=plan["verify"],
                                    verify_timeout=plan["verify_timeout"], trust=plan["trust"], keep=False, preamble_bytes=pre)
            runs.append(start(rex, ns, plan["claude_args"]))
    except BaseException as e:  # die() raises SystemExit; Ctrl-C too: leave nothing behind
        fanout_undo(rex, repo, made, runs)
        if not isinstance(e, KeyboardInterrupt):
            print(f"rex-crew: fanout rolled back: {len(made)} checkout(s) and {len(runs)} worker(s) removed again", file=sys.stderr)
        raise
    for r, (_, br) in zip(runs, made):
        print(f"started {r['name']}   block: {r['block']}   dir: {r['dir']}   branch: {br}")
    print(f"next: rex-crew collect; then rex-crew integrate {shlex.quote(repo)} {' '.join(names)}")


def watched(cmd, vt, m):
    """Shell text: run CMD with a watchdog; prints its last lines, then VRC with the exit status (or timeout)."""
    return ("kt() { set -- \"$1\" \"$2\" $(ps -A -o pid= -o ppid= | awk -v p=\"$1\" '$2==p{print $1}'); kill -s \"$2\" \"$1\" 2>/dev/null; s=$2; shift 2; for c; do kt \"$c\" \"$s\"; done; }; "
            "vf=$(mktemp \"${TMPDIR:-/tmp}/rex-crew-verify.XXXXXX\") || exit 96; "
            f"( {cmd}\n) </dev/null >\"$vf\" 2>&1 & vp=$!; "
            f"( sleep {vt}; : > \"$vf.to\"; kt $vp TERM; sleep 3; kt $vp KILL ) </dev/null >/dev/null 2>&1 & wp=$!; "
            f"wait $vp 2>/dev/null; vrc=$?; kt $wp TERM; if [ -e \"$vf.to\" ]; then vrc=timeout; fi; "
            f"echo {m}VOUT; tail -n 15 \"$vf\" | tail -c 4000; rm -f \"$vf\" \"$vf.to\"; echo {m}VRC $vrc; ")


def cmd_integrate(rex, a):
    names = a.names
    for n in names:
        if not re.fullmatch(NAME_RE, n):
            die(f"NAME {n!r} must be lowercase a-z0-9_- and at most 32 characters", 2)
    if len(set(names)) != len(names):
        die(f"{next(n for n in names if names.count(n) > 1)} is listed twice", 2)
    if a.verify is not None and not a.verify.strip():
        die("--verify is empty: give a command, or leave the option out for no check", 2)
    if a.verify_timeout < 1:
        die("--verify-timeout must be at least 1 second", 2)
    m, repo = f"@@{os.urandom(6).hex()}", shlex.quote(a.repo)
    brs = ["crew/" + n for n in names]
    pre = (f"cd -- {repo} || exit 97; export LC_ALL=C; "
           f"git rev-parse --git-dir >/dev/null 2>&1 || {{ echo {m}ERR {repo} is not a git repository; exit 1; }}; "
           f"cur=$(git branch --show-current); [ -n \"$cur\" ] || echo {m}ERR HEAD is detached: check out the branch that should receive the merges; "
           f"for x in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do [ -e \"$(git rev-parse --git-path $x)\" ] && echo {m}ERR a $x operation is in progress: finish or abort it first; done; "
           f"n=$(git status --porcelain --untracked-files=all | wc -l | tr -d ' '); [ \"$n\" = 0 ] || echo \"{m}ERR the working tree is not clean ($n paths changed or untracked): commit or stash first\"; "
           + "".join(f"git show-ref --verify -q refs/heads/{b} || echo {m}ERR the branch {b} does not exist; "
                     f"[ \"$cur\" = {b} ] && echo {m}ERR {b} is the current branch: it cannot be merged into itself; " for b in brs)
           + f"echo {m}READY")
    rc, out = rex.sh(pre)
    errs = re.findall("^" + re.escape(m) + r"ERR (.*)$", out, re.M)
    if rc == 97:
        errs = [f"the repository {a.repo} was not found on the host"]
    elif not errs and m + "READY" not in out:
        errs = [f"the host's answer is incomplete: {out.strip()[-200:]}"]
    if errs:
        die("nothing was merged: " + "; ".join(errs), 2)
    vt, stopped, empty = int(a.verify_timeout), None, []
    for i, br in enumerate(brs):
        m = f"@@{os.urandom(6).hex()}"
        ver = (watched(a.verify, vt, m) + "if [ \"$vrc\" != 0 ]; then git reset -q --hard \"$before\"; git clean -fdq; fi; ") if a.verify else ""
        rc, out = rex.sh(
            f"cd -- {repo} || exit 97; export LC_ALL=C; before=$(git rev-parse HEAD) || exit 96; "
            f"sha=$(git rev-parse --verify -q refs/heads/{br}) || {{ echo {m}GONE; exit 0; }}; "
            f"wtp=$(git worktree list --porcelain | awk -v b=refs/heads/{br} '/^worktree /{{p=substr($0,10)}} $1==\"branch\" && $2==b {{print p}}'); "
            f"if [ -n \"$wtp\" ]; then echo {m}WTDIRTY $(git -C \"$wtp\" status --porcelain 2>/dev/null | wc -l | tr -d ' '); fi; "
            f"mo=$(git merge --no-ff --no-edit -m \"Merge branch '{br}'\" \"$sha\" 2>&1); mrc=$?; "
            f"if [ $mrc -ne 0 ]; then echo {m}CONFLICT; git -c core.quotepath=false diff --name-only --diff-filter=U | head -n 30; echo {m}NCONF $(git diff --name-only --diff-filter=U | wc -l | tr -d ' '); echo {m}MSG; printf '%s\\n' \"$mo\" | tail -n 5; "
            f"git merge --abort >/dev/null 2>&1; if [ -n \"$(git status --porcelain --untracked-files=all)\" ]; then git reset -q --hard \"$before\"; fi; "
            f"elif [ \"$(git rev-parse HEAD)\" = \"$before\" ]; then echo {m}EMPTY; else echo {m}MERGED; {ver}fi; "
            f"echo {m}STATE $(git status --porcelain --untracked-files=all | wc -l | tr -d ' ') $(git rev-parse --short HEAD); echo {m}END")
        end = re.search("^" + re.escape(m) + r"STATE (\d+) (\S+)$", out, re.M)
        part = lambda x, y: out.split(m + x, 1)[1].split(m + y, 1)[0].strip("\n") if m + x in out else ""
        dirty = re.search("^" + re.escape(m) + r"WTDIRTY (\d+)$", out, re.M)
        note = ""
        if dirty and dirty.group(1) != "0":
            note = f"\n  warning: its checkout has {dirty.group(1)} uncommitted path(s) that are NOT in the branch"
        if not end or m + "END" not in out:
            print(f"{br}: unknown: the host's output is incomplete; check git status in {a.repo}{note}")
            stopped = (br, EXIT["error"], None)
        elif m + "GONE" in out:
            print(f"{br}: unknown: the branch disappeared")
            stopped = (br, 1, end)
        elif m + "CONFLICT" in out:
            files = [f for f in part("CONFLICT", "NCONF").splitlines() if f.strip()]
            total = re.search("^" + re.escape(m) + r"NCONF (\d+)$", out, re.M)
            if files:
                more = int(total.group(1)) - len(files) if total else 0
                print(f"{br}: conflict: " + ", ".join(files) + (f" and {more} more" if more > 0 else "") + note)
            else:
                print(f"{br}: merge failed: " + " ".join(part("MSG", "STATE").split()[-30:]) + note)
            stopped = (br, 1, end)
        elif m + "EMPTY" in out:
            print(f"{br}: nothing to merge: no commits that the current branch lacks; did the worker commit?{note}")
            empty.append(br)
        elif m + "VRC" in out and not re.search("^" + re.escape(m) + r"VRC 0$", out, re.M):
            vr = re.search("^" + re.escape(m) + r"VRC (\S+)$", out, re.M).group(1)
            print(f"{br}: " + (f"verify did not finish within {vt}s and was killed" if vr == "timeout" else f"verify failed (exit {vr})")
                  + ", merge undone" + note)
            tail = part("VOUT", "VRC")
            if tail:
                print("  " + tail.replace("\n", "\n  "))
            stopped = (br, 1, end)
        else:
            print(f"{br}: merged" + (" (verify ok)" if a.verify else "") + note)
        if stopped:
            for rest in brs[i + 1:]:
                print(f"{rest}: not attempted")
            if stopped[2] and stopped[2].group(1) != "0":
                print(f"WARNING: the tree is not clean ({stopped[2].group(1)} paths): look at git status in {a.repo}")
            print(f"stopped at {stopped[0]}" + (f"; the tree is clean at {stopped[2].group(2)}" if stopped[2] and stopped[2].group(1) == "0" else ""))
            sys.exit(stopped[1])
    sys.exit(1 if empty else 0)


def selftest():
    ap, nv = [re.compile(r"^Bash: (rtk )?(git (status|log)|make test|tail|head|grep)\b")], [re.compile(r"\brm\b|git push")]
    assert routine("Bash: git status --short", ap, nv)
    assert routine("Bash: rtk git log -1", ap, nv)
    assert not routine("Bash: git status; rm -rf x", ap, nv)
    assert not routine("Bash: git push", ap, nv) and not routine("", ap, nv)
    assert routine("Bash: git status; rtk git log -3", ap, nv)
    assert not routine("Bash: git status; whoami", ap, nv)
    assert routine("Bash: git log -1 --format='<%ae>' 2>/dev/null", ap, nv)
    assert not routine("Bash: git log > /etc/hosts", ap, nv)
    assert parts("Bash: make test 2>&1 | tail -3") == ["Bash: make test", "Bash: tail -3"]
    assert parts('Bash: grep "a|b" f | head') == ["Bash: grep a|b f", "Bash: head"]
    assert question({"kind": "permission", "msg": "hook failed · approve Bash: ls"}) == ("permission", "Bash: ls")
    assert question({}) == ("", "")
    print("selftest ok")


def main():
    if sys.argv[1:2] == ["selftest"]:
        return selftest()
    argv, agent_args, literal = sys.argv[1:], [], None
    # `send` and `sh` pass their words on as they are: text like -1 or -x is not an option, and a bare -- is not claude's.
    i = 0
    while i < len(argv) and argv[i].startswith("-"):
        i += 2 if argv[i] in ("-S", "--host", "-s", "--session") else 1
    tail = argv[i + 1:]
    if argv[i:i + 1] == ["sh"] and tail and tail not in (["-h"], ["--help"]):
        literal, argv = ("command", tail[1:] if tail[:1] == ["--"] else tail), argv[:i + 1] + ["-"]
    elif argv[i:i + 1] == ["send"] and len(tail) > 1 and tail[0] not in ("-h", "--help"):
        literal, argv = ("text", tail[2:] if tail[1:2] == ["--"] else tail[1:]), argv[:i + 1] + [tail[0], "-"]
    if "--" in argv and not literal:
        i = argv.index("--")
        argv, agent_args = argv[:i], argv[i + 1:]
    raw = argparse.RawDescriptionHelpFormatter
    p = argparse.ArgumentParser(prog="rex-crew", description=__doc__.split("\n\n")[0], formatter_class=raw,
                                epilog="rex-crew selftest   check the policy matcher (needs no Rex)\nrex-crew COMMAND --help   options of one command")
    p.add_argument("-S", "--host", default=os.environ.get("REX_CREW_HOST"), help="Rex host label (default: this machine)")
    p.add_argument("-s", "--session", default=os.environ.get("REX_CREW_SESSION"), help="session id on that host")
    sub = p.add_subparsers(dest="cmd", required=True)

    def task_args(q):
        q.add_argument("name"); q.add_argument("dir"); q.add_argument("task", help="task file, or - for stdin")
        q.add_argument("--verify", help="shell command run in DIR on the host afterwards; its exit status is reported")
        q.add_argument("--trust", action="store_true", help="confirm the folder-trust dialog if it names DIR")
        q.add_argument("--verify-timeout", type=int, default=600, help="seconds the verify command may run before it is killed (default 600)")
        q.add_argument("--keep", action="store_true", help="leave the worker's pane open after it finishes")
        q.add_argument("--preamble", metavar="FILE", help="standing instructions appended to the task (before the report protocol)")

    brief_help = "per worker only: header, ATTENTION, git, verify, the report's CHANGED and OPEN (capped); then a one-line tally"
    claude_args = "usage: rex-crew run NAME DIR TASK [options] -- CLAUDE_ARGS\neverything after a bare -- goes to claude, e.g. -- --permission-mode acceptEdits"
    r = sub.add_parser("run", help="one task, start to report: `start` then `collect` for it", epilog=claude_args, formatter_class=raw)
    task_args(r); r.add_argument("--policy", help="JSON policy file: {approve: [regex], never: [regex]}; without it nothing is answered for you")
    r.add_argument("--timeout", type=int, default=900, help="seconds to wait (default 900); then exit 3, and `collect` waits again")
    r.add_argument("--brief", action="store_true", help=brief_help); r.set_defaults(fn=cmd_run)
    s = sub.add_parser("start", help="put a task on the host and start a worker; returns at once", epilog=claude_args, formatter_class=raw)
    task_args(s); s.set_defaults(fn=cmd_start)
    c = sub.add_parser("collect", help="wait for the open workers: answer routine prompts, report each as it ends; exit 2 when one needs you")
    c.add_argument("name", nargs="?", help="only this worker"); c.add_argument("--policy", help="JSON: {approve: [regex], never: [regex]}")
    c.add_argument("--timeout", type=int, default=900, help="seconds to wait (default 900); then exit 3 and name who is still working")
    c.add_argument("--brief", action="store_true", help=brief_help); c.set_defaults(fn=cmd_collect)
    ru = sub.add_parser("runs", help="what was started in this session (ledger), newest last")
    ru.add_argument("--all", action="store_true", help="every host and session"); ru.add_argument("--last", type=int, help="show this many (default 20)"); ru.set_defaults(fn=cmd_runs)
    co = sub.add_parser("checkout", help="git worktree for one worker on its own branch; prints its path")
    co.add_argument("name"); co.add_argument("repo", help="repository on the host; a relative path is relative to the host's directory")
    co.add_argument("--base", default="HEAD", help="start the branch here (default HEAD)"); co.add_argument("--branch", help="branch name (default crew/NAME)")
    co.add_argument("--copy", action="append", default=[], help="untracked file or folder to copy in (repeatable)"); co.set_defaults(fn=cmd_checkout)
    sh = sub.add_parser("sh", help="run one shell command on the host and print its output")
    sh.add_argument("command", nargs="+"); sh.set_defaults(fn=cmd_sh)
    se = sub.add_parser("send", help="send a message; refused unless the worker is at its prompt")
    se.add_argument("block"); se.add_argument("text", nargs="+"); se.set_defaults(fn=cmd_send)
    ap = sub.add_parser("approve", help="one-time Yes to the open permission prompt")
    ap.add_argument("block"); ap.add_argument("--match", help="approve only if the open prompt matches this regex (else exit 7)"); ap.set_defaults(fn=cmd_approve)
    an = sub.add_parser("answer", help="answer a worker's question: an option number, or free text")
    an.add_argument("block"); an.add_argument("choice")
    an.add_argument("--text", action="store_true", help="CHOICE is free text, even if it is only digits (e.g. a year)"); an.set_defaults(fn=cmd_answer)
    dn = sub.add_parser("deny", help="dismiss the open prompt (Escape)"); dn.add_argument("block"); dn.set_defaults(fn=cmd_deny)
    sc = sub.add_parser("screen", help="the last visible lines of a worker's pane")
    sc.add_argument("block"); sc.add_argument("lines", nargs="?", type=int, default=25)
    sc.set_defaults(fn=lambda rex, a: print(rex.screen(a.block, a.lines)))
    st = sub.add_parser("status", help="every reporting pane in the session: state, label, block, open question")
    st.add_argument("--all", action="store_true", help="also panes that report no status"); st.set_defaults(fn=cmd_status)
    cl = sub.add_parser("close", help="close a worker's pane"); cl.add_argument("block"); cl.set_defaults(fn=cmd_close)
    ss = sub.add_parser("session", help="print the id of the session with this label, creating it if needed")
    ss.add_argument("label"); ss.set_defaults(fn=cmd_session)

    fo = sub.add_parser("fanout", help="one checkout and one worker per entry of a plan file; all or nothing")
    fo.add_argument("plan", help='JSON: {"repo", "base", "copy", "claude_args", "verify", "verify_timeout", "trust", "workers": [{"name", "task_file" or "task"}]}')
    fo.add_argument("--preamble", metavar="FILE", help='standing instructions appended to every task (or the plan key "preamble"; this option wins)')
    fo.set_defaults(fn=cmd_fanout)
    ig = sub.add_parser("integrate", help="merge the workers' branches (crew/NAME) into REPO's current branch, one at a time")
    ig.add_argument("repo", help="repository on the host"); ig.add_argument("names", nargs="+", metavar="NAME")
    ig.add_argument("--verify", help="shell command run in REPO after each merge; a failure undoes that merge and stops")
    ig.add_argument("--verify-timeout", type=int, default=600, help="seconds the verify command may run before it is killed (default 600)")
    ig.set_defaults(fn=cmd_integrate)

    a = p.parse_args(argv)
    a.agent_args = agent_args
    if literal:
        if not literal[1]:
            p.error(f"the following arguments are required: {literal[0]}")
        setattr(a, literal[0], literal[1])
    session = a.session or (None if a.host else os.environ.get("REX_SESSION"))
    if not session and a.cmd != "session":
        die("no session: pass -s, set REX_CREW_SESSION, or run `rex-crew -S HOST session LABEL`", 2)
    a.fn(Rex(a.host, session), a)


if __name__ == "__main__":
    main()
